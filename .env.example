# Copy this file to .env for local development. Never commit .env.
# OpenAI wording assistant (optional; deterministic rules remain authoritative).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ENABLE_LLM=false

# Speech: browser (no key), sarvam (SARVAM_API_KEY), or openai (OPENAI_API_KEY).
SPEECH_PROVIDER=browser
SARVAM_API_KEY=
OPENAI_STT_MODEL=gpt-transcribe
